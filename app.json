{
  "expo": {
    "name": "OpenFahrtenbuch",
    "slug": "openfahrtenbuch",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openfahrtenbuch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.codext.fahrtenbuch",
      "buildNumber": "4",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de",
          "en"
        ],
        "NSLocationWhenInUseUsageDescription": "OpenFahrtenbuch misst während einer laufenden Fahrt die Strecke und ermittelt Start- und Zieladresse. Der Standort bleibt auf deinem iPhone.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OpenFahrtenbuch misst während einer laufenden Fahrt die Strecke, auch wenn du die App verlässt. Der Standort bleibt auf deinem iPhone.",
        "NSLocationAlwaysUsageDescription": "OpenFahrtenbuch misst während einer laufenden Fahrt die Strecke, auch wenn du die App verlässt. Der Standort bleibt auf deinem iPhone.",
        "NSBluetoothAlwaysUsageDescription": "OpenFahrtenbuch verbindet sich mit deinem Bluetooth-OBD-Adapter, um den Kilometerstand des Autos zu lesen."
      },
      "associatedDomains": [
        "applinks:fahrtenbuch.codext.de"
      ]
    },
    "android": {
      "package": "de.codext.fahrtenbuch",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0E9F6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fahrtenbuch.codext.de",
              "path": "/start"
            },
            {
              "scheme": "https",
              "host": "fahrtenbuch.codext.de",
              "path": "/stop"
            },
            {
              "scheme": "https",
              "host": "fahrtenbuch.codext.de",
              "path": "/toggle"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-local-notifications-only.js",
      "./plugins/with-single-location-permission.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0A0C0F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpenFahrtenbuch misst während einer laufenden Fahrt die Strecke und ermittelt Start- und Zieladresse. Der Standort bleibt auf deinem iPhone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "OpenFahrtenbuch verbindet sich mit deinem Bluetooth-OBD-Adapter, um den Kilometerstand des Autos zu lesen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E9F6E"
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-web-browser",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-scene-lifecycle.js",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "OpenFahrtenbuch beschreibt NFC-Tags, mit denen du eine Fahrt startest und beendest.",
          "includeNdefEntitlement": false
        }
      ],
      [
        "./plugins/with-nfc-start.js",
        {
          "host": "fahrtenbuch.codext.de",
          "paths": [
            "/start",
            "/stop",
            "/toggle"
          ],
          "scheme": "openfahrtenbuch"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "Trip",
              "label": "Fahrt starten",
              "description": "Startet und beendet eine Fahrt mit einem Tipp",
              "minWidth": "180dp",
              "minHeight": "56dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "maxResizeHeight": "120dp",
              "previewImage": "./assets/images/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen|keyguard",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_start": {
              "foregroundImage": "./assets/images/shortcut-start.png",
              "backgroundColor": "#FFFFFF"
            },
            "shortcut_stop": {
              "foregroundImage": "./assets/images/shortcut-stop.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    }
  }
}
